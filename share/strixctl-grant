#!/bin/sh
# Hand the ASUS control knobs to the STRIXCTL_GROUP group so the GUI never
# needs root at runtime.  Idempotent, silent about knobs this chassis lacks.
#
# Invoked from two places, because they cover different gaps:
#   * udev, on device add/change  -- catches hotplug and driver reload
#   * strixctl-permissions.service at boot -- catches /sys/firmware/acpi/
#     platform_profile, which is NOT a udev device (there is no
#     platform-profile class before kernel 6.14) and so no rule can match it.

GROUP="${STRIXCTL_GROUP:-users}"

grant() {
    [ -e "$1" ] || return 0
    chgrp "$GROUP" "$1" 2>/dev/null || return 0
    chmod g+w "$1" 2>/dev/null || true
}

# Battery charge-stop threshold
for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    grant "$f"
done

# Platform profile (quiet/balanced/performance)
grant /sys/firmware/acpi/platform_profile

# Custom fan curves, both fans, 8 points each
for hwmon in /sys/class/hwmon/hwmon*; do
    [ -r "$hwmon/name" ] || continue
    [ "$(cat "$hwmon/name")" = "asus_custom_fan_curve" ] || continue
    for n in 1 2; do
        grant "$hwmon/pwm${n}_enable"
        for p in 1 2 3 4 5 6 7 8; do
            grant "$hwmon/pwm${n}_auto_point${p}_temp"
            grant "$hwmon/pwm${n}_auto_point${p}_pwm"
        done
    done
done

# Keyboard backlight brightness
grant /sys/class/leds/asus::kbd_backlight/brightness

exit 0
